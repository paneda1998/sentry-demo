# Start with observability disabled. Reference supports errors/context/replay/tracing.
DEMO_STAGE=off
# One DSN is sufficient for this webinar. Separate projects are optional.
SENTRY_DSN=https://1a6b4a72562153a91a6d6f366e299fed@sentry.hamravesh.com/10391
# If blank, the browser uses SENTRY_DSN. Browser DSNs are public ingestion keys.
SENTRY_BROWSER_DSN=https://ec119562709784ec7943e77ec0d248d8@sentry.hamravesh.com/10392
SENTRY_ENVIRONMENT=webinar
SENTRY_RELEASE=checkout-demo@1.0.0
# Demo sampling is deliberately 100%. Tune this for a real deployment.
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_REPLAYS_SESSION_SAMPLE_RATE=1.0
SENTRY_DEBUG=0
# Defaults keep Django error pages out of the customer-facing page.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=local-webinar-only-change-before-any-deployment
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,testserver
DEMO_FIX_DISCOUNT=0
DEMO_FIX_FRONTEND=0
DEMO_FIX_SHIPPING=0
DEMO_SLOW_SECONDS=2.5
